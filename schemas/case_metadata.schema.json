{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mmmmmhy-1/Table_transfer_bench/blob/main/schemas/case_metadata.schema.json",
  "title": "Table Transformation Benchmark V2.1 — case metadata",
  "description": "Schema for annotation and source provenance. Recommended dimensions may be absent in legacy public examples; future official cases should record them.",
  "type": "object",
  "required": [
    "case_id",
    "benchmark_version",
    "domain",
    "source_family_id",
    "source",
    "operations",
    "structure_tags",
    "split",
    "case_relative_path"
  ],
  "properties": {
    "benchmark": {
      "type": "string"
    },
    "benchmark_version": {
      "const": "2.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "case_number": {
      "type": "integer",
      "minimum": 1
    },
    "case_slug": {
      "type": "string",
      "pattern": "^case_[1-9][0-9]*_[a-z0-9][a-z0-9_-]*$"
    },
    "case_relative_path": {
      "type": "string",
      "pattern": "^data/[a-z][a-z0-9_-]*/case_[1-9][0-9]*_[a-z0-9_-]+$"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "category": {
      "type": "string"
    },
    "source_family_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "source_dataset",
        "source_instance",
        "source_filename",
        "source_url",
        "license",
        "modifications"
      ],
      "properties": {
        "source_dataset": {
          "type": "string",
          "minLength": 1
        },
        "source_instance": {
          "type": "string",
          "minLength": 1
        },
        "source_filename": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "dataset_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "license_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "modifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_sha256": {
          "type": "string"
        },
        "source_domain": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "primary_operation": {
      "$ref": "#/$defs/operation"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "operation_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "$ref": "#/$defs/operation"
          },
          "subtype": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "structure_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "S0",
          "S1",
          "S2",
          "S3",
          "S4"
        ]
      }
    },
    "input_table_stats": {
      "type": "object",
      "additionalProperties": true
    },
    "gold_table_stats": {
      "type": "object",
      "additionalProperties": true
    },
    "difficulty": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": true
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "test",
        "example"
      ]
    },
    "release_role": {
      "enum": [
        "public_demo",
        "public_train",
        "public_dev",
        "held_out_test",
        "internal",
        "review"
      ]
    },
    "dataset_status": {
      "type": "string"
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true
    },
    "header_merges_input": {
      "type": [
        "array",
        "object"
      ],
      "items": {
        "type": "string"
      }
    },
    "header_merges_gold": {
      "type": [
        "array",
        "object"
      ],
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "operation": {
      "enum": [
        "OP1",
        "OP2",
        "OP3",
        "OP4",
        "OP5",
        "OP6"
      ]
    }
  }
}
