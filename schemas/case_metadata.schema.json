{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mmmmmhy-1/Table_transfer_bench/blob/main/schemas/case_metadata.schema.json",
  "title": "Table Transformation Benchmark V2.2 — case metadata",
  "description": "V2.2 adds OP7 Structural Transformation (semantic merge/group/header transformations); existing public case IDs are immutable.",
  "type": "object",
  "required": [
    "case_id",
    "benchmark_version",
    "domain",
    "source_family_id",
    "source",
    "operations",
    "structure_tags",
    "split",
    "case_relative_path"
  ],
  "properties": {
    "benchmark": {
      "type": "string"
    },
    "benchmark_version": {
      "const": "2.2"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "case_number": {
      "type": "integer",
      "minimum": 1
    },
    "case_slug": {
      "type": "string",
      "pattern": "^case_[1-9][0-9]*_[a-z0-9][a-z0-9_-]*$"
    },
    "case_relative_path": {
      "type": "string",
      "pattern": "^data/[a-z][a-z0-9_-]*/case_[1-9][0-9]*_[a-z0-9_-]+$"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "category": {
      "type": "string"
    },
    "source_family_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "source_dataset",
        "source_instance",
        "source_filename",
        "source_url",
        "license",
        "modifications"
      ],
      "properties": {
        "source_dataset": {
          "type": "string",
          "minLength": 1
        },
        "source_instance": {
          "type": "string",
          "minLength": 1
        },
        "source_filename": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "dataset_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "license_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "modifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_sha256": {
          "type": "string"
        },
        "source_domain": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "primary_operation": {
      "$ref": "#/$defs/operation"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "operation_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "$ref": "#/$defs/operation"
          },
          "subtype": {
            "type": "string"
          },
          "table_contract": {
            "$ref": "#/$defs/op6_table_contract"
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "OP6"
                }
              }
            },
            "then": {
              "required": [
                "subtype",
                "table_contract"
              ],
              "properties": {
                "subtype": {
                  "enum": [
                    "J1",
                    "J2",
                    "J3",
                    "J4",
                    "J5",
                    "J6",
                    "J7"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "subtype": {
                        "const": "J1"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "table_contract": {
                        "properties": {
                          "kind": {
                            "const": "join"
                          },
                          "keys": {
                            "maxItems": 1
                          },
                          "cardinality": {
                            "const": "one_to_one"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "subtype": {
                        "const": "J2"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "table_contract": {
                        "properties": {
                          "kind": {
                            "const": "join"
                          },
                          "keys": {
                            "maxItems": 1
                          },
                          "cardinality": {
                            "enum": [
                              "one_to_many",
                              "many_to_one"
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "subtype": {
                        "const": "J3"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "table_contract": {
                        "properties": {
                          "kind": {
                            "const": "join"
                          },
                          "keys": {
                            "maxItems": 1
                          },
                          "cardinality": {
                            "const": "many_to_many"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "subtype": {
                        "const": "J4"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "table_contract": {
                        "properties": {
                          "kind": {
                            "const": "join"
                          },
                          "keys": {
                            "minItems": 2
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "subtype": {
                        "const": "J5"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "table_contract": {
                        "properties": {
                          "kind": {
                            "const": "append_rows"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "subtype": {
                        "const": "J6"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "table_contract": {
                        "properties": {
                          "kind": {
                            "const": "partition_rows"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "subtype": {
                        "const": "J7"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "table_contract": {
                        "properties": {
                          "kind": {
                            "const": "split_columns"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "structure_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "S0",
          "S1",
          "S2",
          "S3",
          "S4"
        ]
      }
    },
    "input_table_stats": {
      "type": "object",
      "additionalProperties": true
    },
    "gold_table_stats": {
      "type": "object",
      "additionalProperties": true
    },
    "difficulty": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": true
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "test",
        "example"
      ]
    },
    "release_role": {
      "enum": [
        "public_demo",
        "public_train",
        "public_dev",
        "held_out_test",
        "internal",
        "review"
      ]
    },
    "dataset_status": {
      "type": "string"
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true
    },
    "header_merges_input": {
      "type": [
        "array",
        "object"
      ],
      "items": {
        "type": "string"
      }
    },
    "header_merges_gold": {
      "type": [
        "array",
        "object"
      ],
      "items": {
        "type": "string"
      }
    },
    "prompt_mode": {
      "type": "string",
      "enum": [
        "discovery",
        "guided"
      ],
      "description": "Default agent-facing prompt mode. Main benchmark uses discovery."
    },
    "prompt_tracks": {
      "type": "object",
      "properties": {
        "discovery": {
          "type": "string"
        },
        "guided": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "operation_taxonomy_revision": {
      "type": "string",
      "description": "Optional taxonomy addendum identifier, e.g. 2.2-op6-v2."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "operation": {
      "enum": [
        "OP1",
        "OP2",
        "OP3",
        "OP4",
        "OP5",
        "OP6",
        "OP7"
      ]
    },
    "op6_table_contract": {
      "type": "object",
      "required": [
        "kind",
        "input_tables",
        "output_tables",
        "duplicate_policy",
        "null_policy",
        "order_policy"
      ],
      "properties": {
        "kind": {
          "enum": [
            "join",
            "append_rows",
            "partition_rows",
            "split_columns"
          ]
        },
        "input_tables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "output_tables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "duplicate_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "null_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "order_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "right": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "additionalProperties": false
          }
        },
        "join_type": {
          "enum": [
            "inner",
            "left",
            "right",
            "full"
          ]
        },
        "cardinality": {
          "enum": [
            "one_to_one",
            "one_to_many",
            "many_to_one",
            "many_to_many"
          ]
        },
        "unmatched_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "column_alignment": {
          "enum": [
            "by_name",
            "explicit_mapping"
          ]
        },
        "schema_policy": {
          "enum": [
            "strict",
            "union",
            "intersection",
            "explicit_mapping"
          ]
        },
        "missing_column_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "column_mapping": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "partition_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "routing_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "row_coverage": {
          "enum": [
            "exactly_once",
            "specified_overlap"
          ]
        },
        "unassigned_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "overlap_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "key_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "column_groups": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "reconstruction_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "join"
              }
            }
          },
          "then": {
            "required": [
              "keys",
              "join_type",
              "cardinality",
              "unmatched_policy"
            ],
            "properties": {
              "input_tables": {
                "minItems": 2,
                "maxItems": 2
              },
              "output_tables": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "append_rows"
              }
            }
          },
          "then": {
            "required": [
              "column_alignment",
              "schema_policy",
              "missing_column_policy"
            ],
            "properties": {
              "input_tables": {
                "minItems": 2
              },
              "output_tables": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "partition_rows"
              }
            }
          },
          "then": {
            "required": [
              "partition_keys",
              "routing_policy",
              "row_coverage",
              "unassigned_policy"
            ],
            "properties": {
              "input_tables": {
                "maxItems": 1
              },
              "output_tables": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "split_columns"
              }
            }
          },
          "then": {
            "required": [
              "key_columns",
              "source_columns",
              "column_groups",
              "reconstruction_policy"
            ],
            "properties": {
              "input_tables": {
                "maxItems": 1
              },
              "output_tables": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "column_alignment": {
                "const": "explicit_mapping"
              }
            },
            "required": [
              "column_alignment"
            ]
          },
          "then": {
            "required": [
              "column_mapping"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "schema_policy": {
                "const": "explicit_mapping"
              }
            },
            "required": [
              "schema_policy"
            ]
          },
          "then": {
            "required": [
              "column_mapping"
            ],
            "properties": {
              "column_alignment": {
                "const": "explicit_mapping"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "row_coverage": {
                "const": "specified_overlap"
              }
            },
            "required": [
              "row_coverage"
            ]
          },
          "then": {
            "required": [
              "overlap_policy"
            ]
          }
        }
      ]
    }
  }
}
